# TypeScript incremental build cache — regenerated by `tsc`/`next build`.
# NOTE: dashboard/tsconfig.tsbuildinfo is still tracked from before this rule was added.
# Run `git rm --cached dashboard/tsconfig.tsbuildinfo` to finish untracking it.
dashboard/*.tsbuildinfo
dashboard/npm-debug.log*
dashboard/yarn-debug.log*
dashboard/yarn-error.log*
dashboard/pnpm-debug.log*

# Environment variable files
.env
.env.*
dashboard/.env
dashboard/.env.*

